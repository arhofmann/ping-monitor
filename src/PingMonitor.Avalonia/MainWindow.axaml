<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PingMonitor.Core;assembly=PingMonitor.Core"
        xmlns:local="clr-namespace:PingMonitor.Avalonia"
        x:Class="PingMonitor.Avalonia.MainWindow"
        x:DataType="core:DisplayState"
        Title="{Binding Title}"
        Icon="/Assets/icon.ico"
        Width="1000" Height="760"
        MinWidth="880" MinHeight="620"
        Background="{DynamicResource WindowBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Text -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.figure">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.rate">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="StackPanel > TextBlock, StackPanel > Path, WrapPanel > TextBlock, Grid.field > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Shrinks a figure that is too long for its place instead of cutting it off. -->
        <Style Selector="Viewbox.fit">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="Path.icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="{DynamicResource InkBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="PathIcon.glyph">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
        </Style>

        <!-- Surfaces -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Padding" Value="14,11,14,12" />
        </Style>
        <!-- The outage list separates its rows with lines; between the column headers there are none. -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="SeparatorBrush" Value="Transparent" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- The status block takes the color of the status level; the code-behind sets the level as a class. -->
        <Style Selector="Border.status">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Border.status Ellipse">
            <Setter Property="Fill" Value="{DynamicResource InkMutedBrush}" />
        </Style>
        <Style Selector="Border.status.Good">
            <Setter Property="Background" Value="{DynamicResource GoodSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GoodLineBrush}" />
        </Style>
        <Style Selector="Border.status.Good Ellipse">
            <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
        </Style>
        <Style Selector="Border.status.Good TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GoodInkBrush}" />
        </Style>
        <Style Selector="Border.status.Warning">
            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
        </Style>
        <Style Selector="Border.status.Warning Ellipse">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.status.Warning TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningInkBrush}" />
        </Style>
        <Style Selector="Border.status.Critical">
            <Setter Property="Background" Value="{DynamicResource CriticalSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CriticalLineBrush}" />
        </Style>
        <Style Selector="Border.status.Critical Ellipse">
            <Setter Property="Fill" Value="{DynamicResource CriticalBrush}" />
        </Style>
        <Style Selector="Border.status.Critical TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource CriticalInkBrush}" />
        </Style>

        <!-- Buttons: "primary" starts the measurement, "outline" stops it, "ghost" is for the actions at the bottom. -->
        <Style Selector="Button.primary, Button.outline">
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <!-- The appearance switch: radio buttons that look like the segments of one control. -->
        <Style Selector="RadioButton.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="0,5">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Background" Value="{DynamicResource SwitchThumbBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="244,*">
        <!-- Sidebar: the status and everything that controls the measurement -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0" Padding="16,18,16,14">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SwitchTrackBrush}" CornerRadius="8" Padding="3"
                        ToolTip.Tip="Appearance: “Auto” follows the system setting.">
                    <UniformGrid Rows="1">
                        <RadioButton Name="autoTheme" Classes="segment" GroupName="theme" Content="Auto"
                                     IsChecked="True" IsCheckedChanged="ThemeChosen" />
                        <RadioButton Name="lightTheme" Classes="segment" GroupName="theme" Content="Light"
                                     IsCheckedChanged="ThemeChosen" />
                        <RadioButton Name="darkTheme" Classes="segment" GroupName="theme" Content="Dark"
                                     IsCheckedChanged="ThemeChosen" />
                    </UniformGrid>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12" Spacing="2">
                    <Button Classes="ghost" Click="ExportClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource ExportIcon}" />
                            <TextBlock Text="Export history …" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Click="ClearClicked">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Data="{StaticResource ClearIcon}" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Data="{StaticResource PulseIcon}"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" />
                        <TextBlock Text="{x:Static core:DisplayState.AppName}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>

                    <Border Name="statusBlock" Classes="status" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Ellipse Width="10" Height="10" Margin="0,4,0,0" VerticalAlignment="Top" />
                                <!-- Two lines at most: a long host name must not push the controls below out of a low window. -->
                                <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding StatusLabel}" />
                            </Grid>
                            <Viewbox Classes="fit">
                                <TextBlock Text="{Binding StatusFigure}" FontSize="34" FontWeight="SemiBold" />
                            </Viewbox>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="heading" Text="Measurement" />
                        <Grid Classes="field" ColumnDefinitions="*,132">
                            <TextBlock Text="Target" />
                            <ComboBox Name="targetBox" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True" Text="1.1.1.1"
                                      ToolTip.Tip="IP address or name. 1.1.1.1 (Cloudflare), 8.8.8.8 (Google) and 9.9.9.9 (Quad9)&#x0a;are public servers that cope well with continuous pings.">
                                <x:String>1.1.1.1</x:String>
                                <x:String>8.8.8.8</x:String>
                                <x:String>9.9.9.9</x:String>
                            </ComboBox>
                        </Grid>
                        <Grid Classes="field" ColumnDefinitions="*,132">
                            <TextBlock Text="Interval (s)" />
                            <NumericUpDown Name="intervalBox" Grid.Column="1" Minimum="1" Maximum="60" Value="1"
                                           FormatString="0" ParsingNumberStyle="Integer"
                                           ToolTip.Tip="Time between two pings in seconds." />
                        </Grid>
                        <!-- Start and Stop share one place; UpdateControls shows the one that applies. -->
                        <Panel Margin="0,2,0,0">
                            <Button Name="startButton" Classes="primary" IsDefault="True" Click="StartClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="glyph" Data="{StaticResource PlayIcon}" />
                                    <TextBlock Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button Name="stopButton" Classes="outline" Click="StopClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="glyph" Data="{StaticResource StopIcon}" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                        </Panel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="heading" Text="View" />
                        <!-- The placeholder shows while the mouse has taken the graph away from the ranges on offer. -->
                        <ComboBox Name="rangeBox" HorizontalAlignment="Stretch" SelectionChanged="RangeChanged"
                                  PlaceholderText="Custom range"
                                  ToolTip.Tip="The time range the graph shows.&#x0a;In the graph itself the mouse wheel zooms and dragging moves the range." />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="heading" Text="Outages" />
                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                            <TextBlock Text="Counted from" />
                            <NumericUpDown Name="thresholdBox" Width="108" Minimum="1" Maximum="30"
                                           FormatString="0" ParsingNumberStyle="Integer" ValueChanged="ThresholdChanged" />
                            <TextBlock Text="lost pings in a row" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="16" RowDefinitions="Auto,7*,3*,Auto" RowSpacing="12">
            <!-- Key figures. The two wider tiles hold the longest texts ("No response", "999 Mbit/s"). -->
            <Grid ColumnDefinitions="5*,4*,5*,4*" ColumnSpacing="10">
                <Border Classes="card tile">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="caption" Text="Response time" />
                        <Viewbox Classes="fit">
                            <TextBlock Classes="figure" Text="{Binding Current}" />
                        </Viewbox>
                        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="Average · minimum / maximum">
                            <Run Text="avg " /><Run Text="{Binding Average}" /><Run Text=" · " /><Run Text="{Binding MinMax}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card tile">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="caption" Text="Packet loss" />
                        <Viewbox Classes="fit">
                            <TextBlock Classes="figure" Text="{Binding Loss}" />
                        </Viewbox>
                        <TextBlock Classes="caption" Text="of all pings" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card tile">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="caption" Text="Data rate" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0" ToolTip.Tip="Download">
                            <Path Classes="icon" Data="{StaticResource DownIcon}"
                                  Stroke="{DynamicResource DownloadBrush}" StrokeThickness="1.8" />
                            <TextBlock Classes="rate" Text="{Binding Download}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="Upload">
                            <Path Classes="icon" Data="{StaticResource UpIcon}"
                                  Stroke="{DynamicResource UploadBrush}" StrokeThickness="1.8" />
                            <TextBlock Classes="rate" Text="{Binding Upload}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="card tile">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="caption" Text="Outages" />
                        <Viewbox Classes="fit">
                            <TextBlock Classes="figure" Text="{Binding OutageCount}" />
                        </Viewbox>
                        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="Total downtime">
                            <Run Text="{Binding Downtime}" /><Run Text=" total" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Classes="card" Padding="16,6,16,8">
                <local:GraphControl Name="graph" TextElement.FontSize="12" />
            </Border>

            <!-- Outages -->
            <Border Grid.Row="2" Classes="card" ClipToBounds="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,10" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Outages" FontWeight="SemiBold" />
                        <Border MinWidth="20" Padding="6,1" VerticalAlignment="Center"
                                Background="{DynamicResource LineBrush}" CornerRadius="10">
                            <TextBlock Classes="caption" Text="{Binding OutageCount}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource LineBrush}" />
                    <!-- The column widths are sized so that the narrowest window needs no horizontal scrolling
                         and the default one shows "(stopped)" after the end of an outage in full. -->
                    <DataGrid Name="outageList" x:DataType="local:OutageListRow"
                              IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start" Width="150" Binding="{Binding Start}" />
                            <DataGridTextColumn Header="End" Width="3*" MinWidth="150" Binding="{Binding End}" />
                            <DataGridTextColumn Header="Duration" Width="100" Binding="{Binding Duration}" />
                            <DataGridTextColumn Header="Lost pings" Width="110" Binding="{Binding LostPings}" />
                            <DataGridTextColumn Header="Target" Width="*" MinWidth="86" Binding="{Binding Target}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <local:PathLabel Name="logLabel" Grid.Row="3" TextElement.FontSize="12"
                             TextElement.Foreground="{DynamicResource AccentBrush}" Click="LogLabelClicked" />
        </Grid>
    </Grid>
</Window>
